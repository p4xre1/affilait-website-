---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleCard from '@/components/ArticleCard.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { CATEGORIES, getCategory, getEdition, localizedPath } from '@/data/site';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { categorySlug: category.slug },
  }));
}

const { categorySlug } = Astro.props as { categorySlug: string };
const locale = 'en' as const;
const edition = getEdition(locale);
const category = getCategory(categorySlug);
const articles = (await getCollection('articles'))
  .filter((article) => article.data.category === category.slug)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
const description = `${category.description} Browse practical, research-led guides from Fatorati's editors.`;
const pageSchema = [{
  '@type': 'CollectionPage',
  '@id': `https://fatorati.me/categories/${category.slug}/#collection`,
  name: `${category.title} lessons and guides`,
  description,
  inLanguage: edition.language,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: articles.map((article, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      url: `https://fatorati.me/articles/${article.id.replace(/\.md$/, '')}/`,
      name: article.data.title,
    })),
  },
}];
---
<BaseLayout locale={locale} title={`${category.title} | Fatorati`} description={description} routePath={`categories/${category.slug}`} keywords={[category.title, 'Semrush tutorials', 'SEO education']} pageSchema={pageSchema} directAnswer={category.description} speakableSelectors={['.category-hero h1', '.category-hero__description']}>
  <section class="category-hero shell">
    <Breadcrumbs items={[
      { label: 'Home', href: localizedPath(locale) },
      { label: 'Articles', href: localizedPath(locale, 'articles') },
      { label: category.title },
    ]} />
    <div class="category-hero__content">
      <span class="category-hero__number">{category.number}</span>
      <div>
        <p class="eyebrow">{category.eyebrow}</p>
        <h1>{category.title}<br /><em>with purpose.</em></h1>
        <p class="category-hero__description">{category.description}</p>
      </div>
    </div>
    <div class="category-hero__bottom"><span>{articles.length} {articles.length === 1 ? 'guide' : 'guides'}</span><a class="text-link" href={localizedPath(locale, 'articles')}>Browse all topics <span aria-hidden="true">↗</span></a></div>
  </section>

  <section class="section-block shell category-results" aria-labelledby="category-results-title">
    <div class="section-heading section-heading--split">
      <div><p class="eyebrow">The learning path</p><h2 id="category-results-title">Start with <em>a useful question.</em></h2></div>
      <p class="section-intro">Each guide turns search research into a practical next step without replacing editorial judgment.</p>
    </div>
    {articles.length > 0 ? (
      <div class="article-grid article-grid--library">
        {articles.map((article, index) => <ArticleCard article={article} locale={locale} featured={index === 0} />)}
      </div>
    ) : (
      <div class="empty-editorial"><p>We are researching this topic. New guides will appear here soon.</p></div>
    )}
  </section>
</BaseLayout>
