---
import { type Category, type EditionCode, localizedPath } from '@/data/site';

interface Props {
  category: Category;
  locale: EditionCode;
  count: number;
}

const { category, locale, count } = Astro.props;
---
<a class="category-card" href={localizedPath(locale, `categories/${category.slug}`)}>
  <span class="category-card__number">{category.number}</span>
  <span class="category-card__eyebrow">{category.eyebrow}</span>
  <span class="category-card__title">{category.title}</span>
  <span class="category-card__description">{category.description}</span>
  <span class="category-card__footer">{count} {count === 1 ? 'guide' : 'guides'} <span aria-hidden="true">↗</span></span>
</a>
